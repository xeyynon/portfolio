# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal working docs — audit/review/planning notes, not meant for the public repo
AUDIT.md
CODE_REVIEW.md
FINAL_REVIEW.md
SESSION_HANDOFF.md
CLAUDE.md
# No markdown is published from this repo: project docs (MD/), CHANGELOG,
# SETUP and any other notes stay local. README.md is already tracked and is
# unaffected by this pattern; its local edits are kept out of commits with
# `git update-index --skip-worktree README.md`.
/MD/
*.md
.impeccable/

# Claude Code local tooling config (not site code)
.claude/
